{
  "name": "darkviws",
  "version": "1.0.0",
  "description": "DARKVIWS AI Video Studio",
  "main": "main.js",
  "author": "DARKVIWS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.darkviws.studio",
    "productName": "DARKVIWS",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DARKVIWS-Setup-${version}.exe"
    }
  }
}